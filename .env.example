# Maison Tisane environment variables.
#
# Copy this file to .env for local work. .env is in .gitignore and must never be
# committed. Real values live only in your .env and in the host's environment
# settings. This file contains no real values.
#
#   Copy-Item .env.example .env

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------

# Required when DEBUG=0. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# 1 locally, 0 in production. Never 1 in production.
DEBUG=1

# Hostnames only, no scheme, comma separated.
# Local:      localhost,127.0.0.1
# Production: maison-tisane.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Full origins including https://, comma separated. Needed in production or
# every form post fails the CSRF origin check with a 403.
# Production: https://maison-tisane.onrender.com
CSRF_TRUSTED_ORIGINS=

# Used for absolute links. Local: http://localhost:8000
SITE_URL=http://localhost:8000

# 0 locally (no TLS on localhost), 1 in production.
FORCE_HTTPS=0

# Bump to invalidate every visitor's service worker cache after a deploy.
APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# SQL database
# ---------------------------------------------------------------------------

# LEAVE EMPTY LOCALLY. Empty means SQLite at db.sqlite3.
# In production use the Render Postgres INTERNAL connection string. SQLite is
# wiped on every free-tier deploy, so it cannot be used there.
#   postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ---------------------------------------------------------------------------
# MongoDB (chat logs and feedback only; the site works without it)
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string. Leave empty to disable chat logging.
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=maison

# ---------------------------------------------------------------------------
# Assistant
# ---------------------------------------------------------------------------

# Google AI Studio key. Leave empty to run the assistant on its rule-based
# answers only, which still satisfies every FAQ and error-code question.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Third-party API and staff access
# ---------------------------------------------------------------------------

# Hard timeout in seconds for the Open-Meteo weather lookup.
EXTERNAL_API_TIMEOUT=3

# Bearer token for the staff ticket endpoints. If this is empty, those
# endpoints deny everyone. Generate a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TICKET_API_TOKEN=
